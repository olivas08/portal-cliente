// Prisma schema — Portal do Cliente (Metalofabril)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum OrderStatus {
  pending
  production
  quality
  shipped
  delivered
}

enum Priority {
  normal
  urgent
}

enum RequestType {
  quote
  complaint
  info
  other
}

enum RequestStatus {
  open
  in_review
  responded
  closed
}

enum MessageFrom {
  client
  admin
}

model Company {
  id        String    @id @default(cuid())
  name      String
  users     User[]
  orders    Order[]
  requests  Request[]
  createdAt DateTime  @default(now())
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CLIENT)
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  createdAt    DateTime @default(now())
}

model Order {
  id            String      @id @default(cuid())
  reference     String      @unique
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id])
  status        OrderStatus @default(pending)
  priority      Priority    @default(normal)
  batchNumber   String
  createdDate   DateTime
  expectedDate  DateTime
  shippedDate   DateTime?
  deliveredDate DateTime?
  qualityNotes  String?
  observations  String?
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reference    String
  description  String
  quantity     Float
  unit         String
  unitPriceEur Float
}

model Request {
  id          String           @id @default(cuid())
  reference   String           @unique
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id])
  type        RequestType
  subject     String
  status      RequestStatus    @default(open)
  createdDate DateTime         @default(now())
  messages    RequestMessage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RequestMessage {
  id         String      @id @default(cuid())
  requestId  String
  request    Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  from       MessageFrom
  authorName String
  text       String
  date       DateTime    @default(now())
}
