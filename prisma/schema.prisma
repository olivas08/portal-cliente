// Prisma schema — Portal do Cliente (Operon)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum OrderStatus {
  pending
  production
  quality
  shipped
  delivered
  cancelled
}

enum Priority {
  normal
  urgent
}

enum RequestType {
  quote
  complaint
  info
  other
}

enum RequestStatus {
  open
  in_review
  responded
  closed
}

enum MessageFrom {
  client
  admin
}

enum QuoteStatus {
  draft
  sent
  accepted
  rejected
}

model Company {
  id            String         @id @default(cuid())
  name          String
  users         User[]
  orders        Order[]
  requests      Request[]
  productPrices ProductPrice[]
  quotes        Quote[]
  createdAt     DateTime       @default(now())
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  passwordHash        String
  role                Role                 @default(CLIENT)
  companyId           String?
  company             Company?             @relation(fields: [companyId], references: [id])
  createdAt           DateTime             @default(now())
  passwordResetTokens PasswordResetToken[]
  notifications       Notification[]

  @@index([companyId])
}

enum NotificationType {
  ORDER_STATUS
  ORDER_CREATED
  REQUEST_CREATED
  REQUEST_MESSAGE
  PRODUCTION_UPDATE
  QUOTE_SENT
  QUOTE_DECISION
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  href      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Order {
  id            String          @id @default(cuid())
  reference     String          @unique
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id])
  status        OrderStatus     @default(pending)
  priority      Priority        @default(normal)
  batchNumber   String?
  createdDate   DateTime
  expectedDate  DateTime
  shippedDate   DateTime?
  deliveredDate DateTime?
  cancelledDate DateTime?
  cancelReason  String?
  qualityNotes  String?
  observations  String?
  items         OrderItem[]
  documents     OrderDocument[]
  workOrders    WorkOrder[]
  quote         Quote?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([companyId])
}

model OrderItem {
  id           String      @id @default(cuid())
  orderId      String
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reference    String
  description  String
  quantity     Float
  unit         String
  unitPriceEur Float
  workOrders   WorkOrder[]

  @@index([orderId])
}

model OrderDocument {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileName       String
  storageKey     String
  mimeType       String
  sizeBytes      Int
  uploadedById   String
  uploadedByName String
  createdAt      DateTime @default(now())

  @@index([orderId])
}

model Request {
  id          String           @id @default(cuid())
  reference   String           @unique
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id])
  type        RequestType
  subject     String
  status      RequestStatus    @default(open)
  createdDate DateTime         @default(now())
  messages    RequestMessage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([companyId])
}

model RequestMessage {
  id         String      @id @default(cuid())
  requestId  String
  request    Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  from       MessageFrom
  authorName String
  text       String
  date       DateTime    @default(now())

  @@index([requestId])
}

model Product {
  id           String             @id @default(cuid())
  reference    String             @unique
  name         String
  description  String
  unit         String
  unitPriceEur Float
  category     String?
  imageUrl     String?
  active       Boolean            @default(true)
  prices       ProductPrice[]
  routing      RoutingOperation[]
  bom          BomItem[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([active])
}

model ProductPrice {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unitPriceEur Float

  @@unique([productId, companyId])
  @@index([companyId])
}

// ── Produção (Ordens de Fabrico) ────────────────────────────────────────────

enum WorkOrderStatus {
  planned
  released
  in_progress
  done
  cancelled
}

enum StepStatus {
  pending
  in_progress
  paused
  done
}

/// How a non-conformity is dispositioned: `rework` sends the part back through
/// the step for reprocessing; `scrap` writes it off.
enum NcDisposition {
  rework
  scrap
}

enum NcStatus {
  open
  resolved
}

/// A shop-floor workstation / process stage. `clientStageLabel` is the
/// customer-friendly abstraction shown in the portal (clients never see
/// machine or operator names).
model Workstation {
  id               String             @id @default(cuid())
  code             String             @unique
  name             String
  clientStageLabel String
  sequence         Int                @default(0)
  active           Boolean            @default(true)
  steps            WorkOrderStep[]
  routingOps       RoutingOperation[]
  machines         Machine[]
  createdAt        DateTime           @default(now())

  @@index([active])
}

model Machine {
  id            String           @id @default(cuid())
  code          String           @unique
  name          String
  workstationId String?
  workstation   Workstation?     @relation(fields: [workstationId], references: [id], onDelete: SetNull)
  tokenHash     String
  active        Boolean          @default(true)
  state         String           @default("offline")
  stateSince    DateTime?
  lastSeenAt    DateTime?
  steps         WorkOrderStep[]
  readings      MachineReading[]
  createdAt     DateTime         @default(now())

  @@index([active])
  @@index([workstationId])
}

model MachineReading {
  id              String         @id @default(cuid())
  machineId       String
  machine         Machine        @relation(fields: [machineId], references: [id], onDelete: Cascade)
  eventId         String
  goodDelta       Int            @default(0)
  scrapDelta      Int            @default(0)
  workOrderStepId String?
  step            WorkOrderStep? @relation(fields: [workOrderStepId], references: [id], onDelete: SetNull)
  producedAt      DateTime
  receivedAt      DateTime       @default(now())

  @@unique([machineId, eventId])
  @@index([machineId, receivedAt])
}

/// A single operation in a product's manufacturing routing (its standard
/// sequence of workstations and expected times). Used to pre-fill a work
/// order's steps; products without a routing fall back to all active
/// workstations.
model RoutingOperation {
  id             String      @id @default(cuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sequence       Int
  name           String
  workstationId  String
  workstation    Workstation @relation(fields: [workstationId], references: [id])
  plannedMinutes Int         @default(0)
  createdAt      DateTime    @default(now())

  @@index([productId])
  @@index([workstationId])
}

/// A shop-floor operator. Authenticates on the shared terminal with a PIN
/// (bcrypt hash) — operators are not portal session users.
model Operator {
  id              String          @id @default(cuid())
  name            String
  pinHash         String
  active          Boolean         @default(true)
  steps           WorkOrderStep[]
  nonConformities NonConformity[]
  createdAt       DateTime        @default(now())

  @@index([active])
}

/// A production work order: what to make, how many, and its progress. Usually
/// one per order line (`orderItemId`). Product reference/name are snapshotted
/// at creation, mirroring the OrderItem snapshot pattern.
model WorkOrder {
  id              String              @id @default(cuid())
  reference       String              @unique
  orderId         String
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId     String?
  orderItem       OrderItem?          @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  productRef      String
  productName     String
  quantityPlanned Float
  quantityDone    Float               @default(0)
  status          WorkOrderStatus     @default(planned)
  priority        Priority            @default(normal)
  plannedStart    DateTime?
  plannedEnd      DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  steps           WorkOrderStep[]
  nonConformities NonConformity[]
  materials       WorkOrderMaterial[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([orderId])
  @@index([status])
}

/// One routing operation of a work order, pinned to a workstation. Steps run
/// in `sequence` order; a step becomes available once every lower-sequence
/// step of the same work order is done. Elapsed work time is accumulated in
/// `actualMinutes` across pause/resume cycles (`startedAt` marks the current
/// running interval).
model WorkOrderStep {
  id              String           @id @default(cuid())
  workOrderId     String
  workOrder       WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  sequence        Int
  name            String
  workstationId   String
  workstation     Workstation      @relation(fields: [workstationId], references: [id])
  status          StepStatus       @default(pending)
  plannedMinutes  Int              @default(0)
  actualMinutes   Float            @default(0)
  downtimeMinutes Float            @default(0)
  quantityDone    Float            @default(0)
  scrapQty        Float            @default(0)
  declaredQty     Float            @default(0)
  machineVerified Boolean          @default(false)
  startedAt       DateTime?
  pausedAt        DateTime?
  finishedAt      DateTime?
  operatorId      String?
  operator        Operator?        @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  machineId       String?
  machine         Machine?         @relation(fields: [machineId], references: [id], onDelete: SetNull)
  nonConformities NonConformity[]
  readings        MachineReading[]

  @@index([workOrderId])
  @@index([workstationId, status])
}

/// A quality non-conformity raised against a work order (optionally a specific
/// step): defective quantity, the reason, and its disposition (rework/scrap).
model NonConformity {
  id          String         @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  stepId      String?
  step        WorkOrderStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  quantity    Float          @default(0)
  reason      String
  disposition NcDisposition
  status      NcStatus       @default(open)
  operatorId  String?
  operator    Operator?      @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  resolvedAt  DateTime?

  @@index([workOrderId])
  @@index([status])
}

// ── Armazém / Stock ──────────────────────────────────────────────────────────

model Material {
  id          String              @id @default(cuid())
  reference   String              @unique
  name        String
  unit        String              @default("un")
  stockQty    Float               @default(0)
  minStockQty Float               @default(0)
  active      Boolean             @default(true)
  bomItems    BomItem[]
  woMaterials WorkOrderMaterial[]
  movements   StockMovement[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([active])
}

model BomItem {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  qtyPerUnit Float
  createdAt  DateTime @default(now())

  @@unique([productId, materialId])
  @@index([materialId])
}

model WorkOrderMaterial {
  id           String    @id @default(cuid())
  workOrderId  String
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  materialId   String
  material     Material  @relation(fields: [materialId], references: [id], onDelete: Restrict)
  materialRef  String
  materialName String
  unit         String    @default("un")
  requiredQty  Float
  issuedQty    Float     @default(0)
  createdAt    DateTime  @default(now())

  @@unique([workOrderId, materialId])
  @@index([materialId])
}

model StockMovement {
  id          String   @id @default(cuid())
  materialId  String
  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  delta       Float
  reason      String
  workOrderId String?
  note        String?
  createdAt   DateTime @default(now())

  @@index([materialId, createdAt])
}

// ── Orçamentos ───────────────────────────────────────────────────────────────

/// Global (single-row) pricing assumptions used to cost quote lines: steel
/// price per kg, plus a default margin. Rates for shop-floor operations
/// (laser, quinagem, soldadura, ...) live in `OperationType` instead, so
/// admins can add/remove operation types without a code change. Editable on
/// `/admin/orcamentos/definicoes` so costing stays realistic without a
/// code change as real supplier/labour rates become known.
model PricingSettings {
  id                   String   @id @default("default")
  steelPriceEurKg      Float    @default(4.5)
  defaultMarginPercent Float    @default(25)
  updatedAt            DateTime @updatedAt
}

/// A configurable shop-floor processing step (corte a laser, quinagem,
/// soldadura, acabamento, jato de água, anodização, ...) priced at a rate
/// per unit (minute, bend, m², etc). Admins manage this list on
/// `/admin/orcamentos/definicoes` so new operations can be added as the
/// business needs them, without a code change or migration. `active`
/// hides an operation from new quotes without breaking historical quotes
/// that already reference it (their `QuoteLineOperation` rows keep a
/// frozen name/unit/rate snapshot regardless).
model OperationType {
  id             String               @id @default(cuid())
  key            String               @unique
  name           String
  unit           String
  ratePerUnitEur Float
  active         Boolean              @default(true)
  sequence       Int                  @default(0)
  lines          QuoteLineOperation[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

/// A custom quote (orçamento) for a client company, priced line-by-line from
/// material weight + operation time using `PricingSettings`. Mirrors the
/// Order/Request lifecycle: `draft` while the admin is composing it, `sent`
/// once the client can see and decide on it, then `accepted` (which also
/// creates an `Order` from its lines) or `rejected`.
model Quote {
  id            String      @id @default(cuid())
  reference     String      @unique
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id])
  subject       String
  notes         String?
  status        QuoteStatus @default(draft)
  marginPercent Float
  totalEur      Float       @default(0)
  validUntil    DateTime?
  orderId       String?     @unique
  order         Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  lines         QuoteLine[]
  createdDate   DateTime    @default(now())
  sentAt        DateTime?
  decidedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([companyId])
  @@index([status])
}

/// One priced line of a quote. `unitCostEur`/`lineTotalEur` are computed and
/// persisted at save time (from `PricingSettings` + the operations below),
/// not recomputed live, so a sent quote's price never silently drifts if
/// the global rates are edited afterwards.
model QuoteLine {
  id               String               @id @default(cuid())
  quoteId          String
  quote            Quote                @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sequence         Int
  description      String
  quantity         Float
  unit             String               @default("un")
  materialWeightKg Float                @default(0)
  operations       QuoteLineOperation[]
  unitCostEur      Float
  lineTotalEur     Float

  @@index([quoteId])
}

/// One shop-floor operation applied to a quote line (e.g. "Corte a laser ×
/// 10 min"). `name`/`unit`/`ratePerUnitEur` are frozen from `OperationType`
/// at save time — like the rest of quote pricing — so editing/removing an
/// `OperationType` later never changes an already-priced quote.
model QuoteLineOperation {
  id              String         @id @default(cuid())
  quoteLineId     String
  quoteLine       QuoteLine      @relation(fields: [quoteLineId], references: [id], onDelete: Cascade)
  operationTypeId String?
  operationType   OperationType? @relation(fields: [operationTypeId], references: [id], onDelete: SetNull)
  name            String
  unit            String
  quantity        Float
  ratePerUnitEur  Float
  costEur         Float

  @@index([quoteLineId])
  @@index([operationTypeId])
}
