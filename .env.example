# Copy to `.env` and fill in. Prisma 6 reads these via prisma.config.ts.

# PostgreSQL
# DATABASE_URL — Transaction pooler on Supabase (port 6543), or local Postgres.
# DIRECT_URL — Direct connection (port 5432). Optional locally: if omitted,
# prisma.config.ts copies DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Optional — emails (password reset, order status). Logged to console if unset.
# RESEND_API_KEY=""
# EMAIL_FROM="Operon <noreply@example.com>"

# Optional — order attachment uploads (Supabase Storage bucket `order-documents`).
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""

# Optional — invoicing adapter (moloni | vendus | sage100 | primavera | invoicexpress)
# INVOICE_PROVIDER=""
