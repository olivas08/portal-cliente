# Copy to `.env` and fill in. Prisma 6 reads these via prisma.config.ts.

# PostgreSQL (Supabase: Project Settings → Database → Connect → Prisma)
#
# DATABASE_URL — Transaction pooler (port 6543, host *.pooler.supabase.com).
# DIRECT_URL — Session pooler (port 5432, SAME pooler host). Do NOT use
# db.<project>.supabase.co:5432 from Vercel: that host is IPv6-only and
# `prisma migrate deploy` fails with P1001 during the build.
#
# Local Postgres: both can be the same URL; prisma.config.ts copies
# DATABASE_URL into DIRECT_URL if DIRECT_URL is unset.
DATABASE_URL="postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Optional — emails (password reset, order status). Logged to console if unset.
# RESEND_API_KEY=""
# EMAIL_FROM="Operon <noreply@example.com>"

# Optional — order attachment uploads (Supabase Storage bucket `order-documents`).
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""

# Optional — invoicing adapter (moloni | vendus | sage100 | primavera | invoicexpress)
# INVOICE_PROVIDER=""
